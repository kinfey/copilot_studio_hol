{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportDate", "revenueCNY", "orderCount", "units", "previousRevenueCNY", "wowPercent", "topRegion", "topProduct", "summary", "risks", "nextActions", "emailSubject", "emailBody", "pptOutline"],
  "properties": {
    "reportDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "revenueCNY": { "type": "number", "minimum": 0 },
    "orderCount": { "type": "integer", "minimum": 1 },
    "units": { "type": "integer", "minimum": 0 },
    "previousRevenueCNY": { "type": "number", "minimum": 0 },
    "wowPercent": { "type": ["number", "null"] },
    "topRegion": { "$ref": "#/definitions/ranked" },
    "topProduct": { "$ref": "#/definitions/ranked" },
    "summary": { "type": "string", "minLength": 1 },
    "risks": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/definitions/textItem" } },
    "nextActions": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/definitions/textItem" } },
    "emailSubject": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
    "emailBody": { "type": "string", "minLength": 1 },
    "pptOutline": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "body"],
        "properties": { "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "definitions": {
    "ranked": {
      "type": "object", "additionalProperties": false, "required": ["name", "revenueCNY"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "revenueCNY": { "type": "number", "minimum": 0 } }
    },
    "textItem": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1 } }
    }
  }
}
