{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "category", "needsClarification", "clarificationQuestion", "riskNotes"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "category": { "type": "string", "enum": ["sales", "operations", "other"] },
    "needsClarification": { "type": "boolean" },
    "clarificationQuestion": { "type": "string", "maxLength": 200 },
    "riskNotes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": { "text": { "type": "string", "maxLength": 120 } }
      }
    }
  }
}
